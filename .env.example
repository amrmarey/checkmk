# Copy this file to .env and adjust values for your environment.
# The .env file is gitignored and should never be committed.

# Host port for the Checkmk web interface (container listens on 5000)
CHECKMK_PORT=8080

# Host port for the Checkmk agent receiver (container listens on 8000)
CHECKMK_REGISTER_PORT=8000

# OMD site name. Becomes the URL path: http://localhost:${CHECKMK_PORT}/${CMK_SITE_ID}/
# Must match the tmpfs mount path in docker-compose.yml.
CMK_SITE_ID=mysite

# Optional: set the initial cmkadmin password.
# If unset, the container generates a random password on first start;
# retrieve it with:  docker logs monitoring 2>&1 | grep -i "password"
# CMK_PASSWORD=change-me-on-first-login
