# Copy this file to .env and adjust values for your environment.
# The .env file is gitignored and should never be committed.

# Host port for the Checkmk web interface (container listens on 5000)
CHECKMK_PORT=8080

# Host port for the Checkmk agent receiver (container listens on 8000)
CHECKMK_REGISTER_PORT=8000

# OMD site name. Becomes the URL path: http://localhost:${CHECKMK_PORT}/${CMK_SITE_ID}/
# Must match the tmpfs mount path in docker-compose.yml.
CMK_SITE_ID=mysite

# Initial admin user. The Checkmk image hardcodes this as 'cmkadmin' on
# first boot — this variable is documentary only and is NOT read by the
# container. Rename or replace post-install via the UI if needed.
CMK_USERNAME=cmkadmin

# Initial password for cmkadmin. Read by the container on first start only.
# Leave commented to have the container auto-generate a password (retrieve it
# with: docker logs monitoring 2>&1 | grep -i "password"). If you set it, use
# a long unique passphrase and change it after first login.
# CMK_PASSWORD=change-me-on-first-login
